{
  "name": "@tomtastisch/agent-governance",
  "version": "1.4.0",
  "description": "Interactive and transactional Agent Governance CLI with resume-toon and work-items exports, SSOT domains, template registry, and module routing",
  "keywords": [
    "agent-governance",
    "ai-governance",
    "governance-as-code",
    "policy-as-code",
    "ai-agents",
    "coding-agents",
    "coding-agent-governance",
    "ai-security",
    "developer-tools",
    "cli",
    "harness-agnostic",
    "llm",
    "installer"
  ],
  "type": "module",
  "bin": {
    "agent-governance": "dist/cli.js"
  },
  "exports": {
    "./resume-toon": {
      "types": "./dist/resume-toon.d.ts",
      "default": "./dist/resume-toon.js"
    },
    "./work-items": {
      "types": "./dist/work-items.d.ts",
      "default": "./dist/work-items.js"
    }
  },
  "files": [
    "dist",
    "prebuilds",
    "bundle",
    "assets/branding/agent-governance-terminal.png",
    "docs/installer-cli-reference.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "release.files.sha256",
    "VERSION"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:native": "node tools/build-native.mjs",
    "build": "npm run build:native && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "npm run build:native && node --experimental-strip-types --test tests/installer/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit && git diff --check",
    "pack:check": "npm pack --dry-run --json | node tools/verify-pack.mjs",
    "test:package": "tests/e2e/run_package_consumers.sh",
    "license:check": "node tools/verify-licenses.mjs"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomtastisch/agent-governance.git"
  },
  "homepage": "https://github.com/tomtastisch/agent-governance#readme",
  "bugs": "https://github.com/tomtastisch/agent-governance/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@toon-format/toon": "4.1.1",
    "smol-toml": "1.8.0"
  }
}
